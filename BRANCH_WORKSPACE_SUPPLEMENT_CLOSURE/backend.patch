+// Run the shipped script unchanged with an isolated DOM/fetch, without a browser or server.
+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const source = fs.readFileSync(path.join(__dirname, '../public/assets/common/js/nirab-branch.js'), 'utf8');
+
+class Element {
+    constructor(tag = 'div') { this.tag = tag; this.children = []; this.listeners = {}; this.dataset = {}; this.fields = {}; this.hidden = false; this.disabled = false; this.className = ''; this.parent = {hidden: false}; }
+    set textContent(value) { this.text = String(value); this.children = []; }
+    get textContent() { return this.text || ''; }
+    append(...elements) { this.children.push(...elements); }
+    replaceChildren(...elements) { this.children = elements; }
+    addEventListener(type, listener) { this.listeners[type] = listener; }
+    setAttribute() {}
+    closest() { return this.parent; }
+    createTHead() { const el = new Element('thead'); this.append(el); return el; }
+    createTBody() { const el = new Element('tbody'); this.append(el); return el; }
+    insertRow() { const el = new Element('tr'); this.append(el); return el; }
+    insertCell() { const el = new Element('td'); this.append(el); return el; }
+}
+function descendants(element, tag) { return element.children.flatMap(child => [ ...(child.tag === tag ? [child] : []), ...descendants(child, tag)]); }
+const flush = () => new Promise(resolve => setImmediate(resolve));
+function world(fetcher, quotes = false) {
+    const elements = new Map([['branch-message', new Element()]]);
+    const action = new Element('form'); action.dataset.endpoint = 'bookings/booking/visit/status'; action.fields = {booking_status: 'accepted', reason: 'Reviewed'};
+    if (quotes) for (const id of ['quote-filter', 'quote-detail', 'quote-description', 'quote-versions', 'quote-inspections', 'quote-issue', 'quote-inspection', 'branch-quotes', 'quote-pages']) elements.set(id, new Element(id.includes('filter') || id.includes('issue') || id === 'quote-inspection' ? 'form' : 'div'));
+    const requests = [], location = {origin: 'https://nirab.test', reloads: 0, reload() { this.reloads++; }};
+    const document = {getElementById: id => elements.get(id), createElement: tag => new Element(tag), querySelectorAll: selector => selector === '.branch-action' ? [action] : []};
+    const labels = {saved: 'Saved', failed: 'Failed', saved_refresh_failed: 'Saved successfully; display refresh failed.', refresh: 'Refresh data', refreshed: 'Data refreshed.'};
+    const window = {location, nirabBranch: {base: 'https://nirab.test/provider/branch-workspace', branchId: 'branch-a', csrf: 'csrf-token', labels}};
+    class FormData { constructor(form) { this.values = Object.entries(form.fields); } [Symbol.iterator]() { return this.values[Symbol.iterator](); } }
+    vm.runInNewContext(source, {window, document, URL, URLSearchParams, FormData, setTimeout, fetch: async (url, options) => { requests.push({url, ...options}); return fetcher(url, options); }});
+    return {elements, action, location, requests};
+}
+const response = (code = 'default_200', content = null, status = 200, errors = [], message = '') => ({ok: status >= 200 && status < 300, json: async () => ({response_code: code, content, errors, message})});
+async function submit(form) { const button = new Element('button'); await form.listeners.submit({preventDefault() {}, submitter: button}); return button; }
+
+for (const code of ['default_200', 'default_store_200', 'default_update_200', 'default_status_update_200', 'default_delete_200', 'no_changes_found_200']) test('accepts supported success code ' + code, async () => {
+    const app = world(() => response(code)); await submit(app.action);
+    assert.equal(app.location.reloads, 1);
+    assert.equal(app.requests[0].url.searchParams.get('branch_id'), 'branch-a');
+    assert.equal(app.requests[0].method, 'POST');
+    assert.equal(app.requests[0].headers['X-CSRF-TOKEN'], 'csrf-token');
+    assert.equal(app.requests[0].credentials, 'same-origin');
+});
+for (const code of ['default_400', 'default_fail_200']) test('rejects application error with empty errors array: ' + code, async () => {
+    const app = world(() => response(code, null, 200, [], 'Business rule rejected'));
+    const button = await submit(app.action);
+    assert.equal(app.location.reloads, 0); assert.equal(button.disabled, false);
+    assert.equal(app.elements.get('branch-message').textContent, 'Business rule rejected');
+});
+test('rejects validation and network failures without leaving the form disabled', async () => {
+    for (const fetcher of [() => response('default_400', null, 422, [{message: 'Validation failed'}]), () => { throw new Error('Network unavailable'); }]) {
+        const app = world(fetcher); const button = await submit(app.action);
+        assert.equal(button.disabled, false); assert.equal(app.location.reloads, 0);
+        assert.equal(app.elements.get('branch-message').className, 'alert alert-danger');
+    }
+});
+
+for (const formId of ['quote-issue', 'quote-inspection']) test('reports successful ' + formId + ' save separately from refresh failure, and retries GET only', async () => {
+    let saved = false, mayRefresh = false;
+    const quote = {id: 'quote-a', quote_status: 'under_review', quotations: [], inspections: [], attachments: []};
+    const app = world((url, options) => {
+        if (options.method === 'POST') { saved = true; return response('default_store_200', {id: 'saved'}, 201); }
+        if (url.pathname.endsWith('/quotes/quote-a')) {
+            if (saved && !mayRefresh) throw new Error('Refresh unavailable');
+            return response('default_200', quote);
+        }
+        return response('default_200', {data: [quote], current_page: 1, last_page: 1});
+    }, true);
+    await flush();
+    await descendants(app.elements.get('branch-quotes'), 'button')[0].onclick();
+    await submit(app.elements.get(formId));
+    const notice = app.elements.get('branch-message');
+    assert.match(notice.textContent, /^Saved successfully/); assert.equal(notice.className, 'alert alert-warning');
+    assert.equal(app.requests.filter(r => r.method === 'POST').length, 1);
+    mayRefresh = true;
+    await notice.children[0].onclick();
+    assert.equal(notice.textContent, 'Data refreshed.');
+    assert.equal(app.requests.filter(r => r.method === 'POST').length, 1);
+});
+
+test('complaint attachment links use the same branch-aware endpoint as quality API calls', () => {
+    const template = fs.readFileSync(path.join(__dirname, '../Modules/AdminModule/Resources/views/quality/index.blade.php'), 'utf8');
+    const helper = template.match(/    function endpointUrl\(path\) \{[\s\S]*?(?=    async function api)/)[0];
+    assert.match(template, /link\.href=endpointUrl\('\/complaints\/'.*?\/attachments\//);
+    for (const branchId of ['branch-a', null]) {
+        const url = vm.runInNewContext(helper + "endpointUrl('/complaints/ticket-a/attachments/0').href", {base: 'https://nirab.test/admin/branch-workspace/quality', branchId, workspaceDates: {from: '2026-10-01', to: '2026-10-08'}, URL, window: {location: {origin: 'https://nirab.test'}}});
+        assert.equal(new URL(url).searchParams.get('branch_id'), branchId);
+    }
+});
