+        'invoice_status', 'sync_status', 'event', 'entity_id', 'page', 'payment_page', 'collection_page', 'refund_page', 'entry_page', 'outbox_page'];
+
+    private static function state(array $values): array
+    {
+        return array_filter(Arr::only($values, self::STATE_KEYS), fn ($value) => is_scalar($value) && $value !== '');
+    }
+
+    public static function detailPage(Request $request, array $pages = ['details', 'status']): string
+    {
+        $request->validate(['web_page' => 'nullable|in:' . implode(',', $pages)]);
+        return $request->input('web_page') ?: 'details';
+    }
+
+    public static function detailParameters(Request $request, string $id, ?array $filters = null): array
+    {
+        $state = self::state((array) $request->input('workspace', $request->query()));
+        if ($filters) $state = array_merge($state, Arr::only($filters, ['from', 'to', 'period']));
+        $state['tab'] ??= 'bookings';
+        return ['id' => $id, 'web_page' => 'details', 'branch_id' => $request->input('branch_id'), 'workspace' => $state];
+    }
+
+    public static function returnParameters(Request $request): array
+    {
+        $state = self::state((array) $request->input('workspace', []));
+        // Existing bookmarked links used only these two date parameters.
+        foreach (['from', 'to'] as $key) if (!isset($state[$key]) && $request->filled('workspace_' . $key)) $state[$key] = $request->input('workspace_' . $key);
+        $state['tab'] ??= 'bookings';
+        return array_merge($state, ['branch_id' => $request->input('branch_id')]);
+    }
+}
