APP_NAME=NIRAB
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Keep enabled for NIRAB's single-company, multi-branch operating model.
NIRAB_BRANCH_MODE=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nirab
DB_USERNAME=nirab
DB_PASSWORD=

# Only needed when manually seeding the first HQ administrator.
NIRAB_BOOTSTRAP_ADMIN_EMAIL=
NIRAB_BOOTSTRAP_ADMIN_PHONE=
NIRAB_BOOTSTRAP_ADMIN_PASSWORD=


BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MAINTENANCE_SECRET=
SOFTWARE_ID=NDAyMjQ3NzI=

# NIRAB dispatch defaults
NIRAB_ASSIGNMENT_DELAY_MINUTES=10
NIRAB_MAX_ASSIGNMENT_ATTEMPTS=5
NIRAB_TRAVEL_BUFFER_MINUTES=15
NIRAB_LATE_ARRIVAL_GRACE_MINUTES=15
NIRAB_BRANCH_FALLBACK_RADIUS_KM=50
NIRAB_AVERAGE_TRAVEL_SPEED_KMH=30
NIRAB_LOCATION_MAX_AGE_MINUTES=15

# NIRAB phase 4: execution proof and cash custody
NIRAB_EXECUTION_ENABLED=true
NIRAB_REQUIRE_GEO_CHECK_IN=true
NIRAB_REQUIRE_GEO_CHECK_OUT=true
# Zero disables the optional distance check.
NIRAB_CHECK_IN_RADIUS_METERS=0
NIRAB_BEFORE_PHOTO_MINIMUM=1
NIRAB_AFTER_PHOTO_MINIMUM=1
NIRAB_REQUIRE_CUSTOMER_OTP=true
NIRAB_OVERRIDE_REQUIRES_EVIDENCE=false
NIRAB_TECHNICIAN_CASH_CUSTODY_LIMIT=3000
NIRAB_HANDOVER_OVERDUE_HOURS=24
NIRAB_SETTLEMENT_TIMEZONE=Asia/Riyadh

# Phase 5: payment keys stay on the backend. Tabby/Tamara use Tap credentials.
NIRAB_PAYMENT_MODE=test
TAP_ENABLED=false
TABBY_ENABLED=false
TAMARA_ENABLED=false
TAP_PUBLIC_KEY=
TAP_TEST_SECRET_KEY=
TAP_LIVE_SECRET_KEY=
TAP_TEST_MERCHANT_ID=
TAP_LIVE_MERCHANT_ID=
TAP_TEST_WEBHOOK_SECRET=
TAP_LIVE_WEBHOOK_SECRET=
TAP_SOURCE_ID=src_all
NIRAB_PAYMENT_RETURN_HOSTS=
NIRAB_GATEWAY_CHECKOUT_HOSTS=checkout.tap.company,api.tap.company,checkout.tabby.ai,checkout.tamara.co
# Finance never uses sync; set CACHE_STORE=redis and QUEUE_CONNECTION=redis in production.
CACHE_STORE=file
NIRAB_FINANCE_QUEUE_CONNECTION=database
NIRAB_FINANCE_QUEUE=nirab-finance
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5
ODOO_ENABLED=false
ODOO_TRANSPORT=json2
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_COMPANY_ID=
ODOO_SAR_CURRENCY_ID=
ODOO_SALES_JOURNAL_ID=
ODOO_CASH_JOURNAL_ID=
ODOO_BANK_JOURNAL_ID=
ODOO_BANK_RECEIPT_ACCOUNT_ID=
ODOO_WALLET_JOURNAL_ID=
ODOO_PAYMENT_METHOD_LINE_ID=
ODOO_OUTBOUND_PAYMENT_METHOD_LINE_ID=
# Each method line must belong to its configured cash/bank journal.
ODOO_CASH_PAYMENT_METHOD_LINE_ID=
ODOO_BANK_PAYMENT_METHOD_LINE_ID=
ODOO_CASH_OUTBOUND_PAYMENT_METHOD_LINE_ID=
ODOO_BANK_OUTBOUND_PAYMENT_METHOD_LINE_ID=
ODOO_WALLET_LIABILITY_ACCOUNT_ID=
ODOO_WALLET_CLEARING_ACCOUNT_ID=
ODOO_PROMOTION_ACCOUNT_ID=
ODOO_SUBSCRIPTION_REVENUE_ACCOUNT_ID=
ODOO_CUSTODY_ACCOUNT_ID=
ODOO_CASH_ACCOUNT_ID=
ODOO_CUSTODY_CLEARING_ACCOUNT_ID=
ODOO_IDENTITY_FIELD=x_nirab_key
ODOO_PAYMENT_REFERENCE_FIELD=memo
ODOO_ANALYTIC_FIELD=analytic_distribution
ODOO_INVOICE_UUID_FIELD=l10n_sa_uuid
ODOO_ZATCA_STATUS_FIELD=l10n_sa_edi_state
ODOO_INVOICE_QR_FIELD=l10n_sa_qr_code_str
ODOO_INVOICE_PDF_REPORT_PATH=/report/pdf/account.report_invoice/
ODOO_INVOICE_PDF_ATTACHMENT_FIELD=invoice_pdf_report_id
ODOO_REPORT_PASSWORD=
ODOO_INVOICE_CALLBACK_SECRET=

# Phase 6 quality, private storage and durable communications (disabled external delivery).
NIRAB_LOW_RATING_THRESHOLD=3
NIRAB_WARRANTY_DAYS=7
NIRAB_COMPLAINT_SLA_HOURS=24
NIRAB_PRIVATE_DISK=local
NIRAB_LOCATION_RETENTION_DAYS=7
NIRAB_EVIDENCE_RETENTION_DAYS=180
NIRAB_COMMUNICATION_RETENTION_DAYS=90
NIRAB_REPORT_CACHE_SECONDS=60
NIRAB_MAX_REPORT_DAYS=366
NIRAB_LOCK_STORE=file
NIRAB_DISPATCH_RATING_WEIGHT=0.25
NIRAB_DISPATCH_ETA_WEIGHT=0.60
NIRAB_DISPATCH_WORKLOAD_WEIGHT=0.15
NIRAB_PUSH_ENABLED=false
NIRAB_COMMUNICATION_QUEUE_CONNECTION=database
NIRAB_COMMUNICATION_QUEUE=communications
NIRAB_COMMUNICATION_MAX_ATTEMPTS=5
NIRAB_SMS_PROVIDER=
NIRAB_SMS_ENABLED=false
NIRAB_SMS_SENDER=
NIRAB_SMS_OTP_TEMPLATE=
UNIFONIC_SMS_ENDPOINT=https://el.cloud.unifonic.com/rest/SMS/messages
UNIFONIC_APP_SID=
TAQNYAT_SMS_ENDPOINT=https://api.taqnyat.sa/v1/messages
TAQNYAT_API_TOKEN=
NIRAB_WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_ENDPOINT=https://graph.facebook.com/v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=
WHATSAPP_TEMPLATE_INVOICE_READY=
NIRAB_BACKUP_ENABLED=false
NIRAB_BACKUP_TIME=02:00
NIRAB_BACKUP_TIMEZONE=Asia/Riyadh
NIRAB_BACKUP_DISK=local
NIRAB_BACKUP_PREFIX=nirab-backups/database
NIRAB_BACKUP_RETENTION_DAYS=30
DUMP_BINARY_PATH=

# Private bank-transfer evidence: offline_receipts (local), or s3 for a private R2 bucket.
OFFLINE_RECEIPT_DISK=offline_receipts

# Public marketing landing: keep prelaunch indexing and unapproved reviews disabled.
NIRAB_CUSTOMER_WEB_URL=https://app.nirabclean.com
NIRAB_LANDING_INDEXABLE=false
NIRAB_LANDING_TESTIMONIALS_ENABLED=false
