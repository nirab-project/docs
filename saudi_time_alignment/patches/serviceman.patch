diff --git a/lib/helper/saudi_time.dart b/lib/helper/saudi_time.dart
new file mode 100644
index 0000000..c53402a
--- /dev/null
+++ b/lib/helper/saudi_time.dart
@@ -0,0 +1,80 @@
+import 'package:timezone/data/latest.dart' as tzdata;
+import 'package:timezone/timezone.dart' as tz;
+
+/// Saudi appointments are civil wall time; technical timestamps are UTC instants.
+/// Never use the device timezone to interpret a business appointment.
+abstract final class SaudiTime {
+  static const timezone = 'Asia/Riyadh';
+  static final tz.Location _riyadh = _location();
+
+  static tz.Location _location() {
+    tzdata.initializeTimeZones();
+    return tz.getLocation(timezone);
+  }
+
+  static bool _hasZone(String value) =>
+      RegExp(r'(Z|[+-]\d{2}:?\d{2})$', caseSensitive: false).hasMatch(value);
+
+  static DateTime now() => tz.TZDateTime.now(_riyadh);
+
+  /// Legacy unzoned appointments keep their Saudi hour without any +3 shift.
+  static DateTime appointment(String value) {
+    final raw = value.trim();
+    final civil = raw.contains(RegExp('[T ]')) ? raw : '${raw}T00:00:00';
+    return tz.TZDateTime.from(
+      DateTime.parse(_hasZone(raw) ? raw : '$civil+03:00'),
+      _riyadh,
+    );
+  }
+
+  static DateTime? tryAppointment(String? value) {
+    try {
+      return value == null ? null : appointment(value);
+    } on FormatException {
+      return null;
+    }
+  }
+
+  /// Unzoned creation, expiry and event timestamps are UTC, unlike appointments.
+  static DateTime instant(String value) {
+    final raw = value.trim();
+    final civil = raw.contains(RegExp('[T ]')) ? raw : '${raw}T00:00:00';
+    return tz.TZDateTime.from(
+      DateTime.parse(_hasZone(raw) ? raw : '${civil}Z'),
+      _riyadh,
+    );
+  }
+
+  static DateTime? tryInstant(String? value) {
+    try {
+      return value == null ? null : instant(value);
+    } on FormatException {
+      return null;
+    }
+  }
+
+  /// Picker values hold civil components, not a device-local instant.
+  static DateTime wall(DateTime value) => tz.TZDateTime(
+    _riyadh,
+    value.year,
+    value.month,
+    value.day,
+    value.hour,
+    value.minute,
+    value.second,
+    value.millisecond,
+    value.microsecond,
+  );
+
+  static DateTime forDisplay(DateTime value) =>
+      value is tz.TZDateTime || value.isUtc
+      ? tz.TZDateTime.from(value, _riyadh)
+      : wall(value);
+
+  static String appointmentToken(DateTime value) {
+    final date = forDisplay(value);
+    String two(int n) => n.toString().padLeft(2, '0');
+    return '${date.year.toString().padLeft(4, '0')}-${two(date.month)}-${two(date.day)}'
+        'T${two(date.hour)}:${two(date.minute)}:${two(date.second)}+03:00';
+  }
+}
diff --git a/test/unit/saudi_time_contract_check.dart b/test/unit/saudi_time_contract_check.dart
new file mode 100644
index 0000000..c082ed5
--- /dev/null
+++ b/test/unit/saudi_time_contract_check.dart
@@ -0,0 +1,71 @@
+import 'package:timezone/timezone.dart' as tz;
+import 'package:demandium_serviceman/helper/saudi_time.dart';
+
+// Run with dart run; no Flutter binding, device, widgets or application startup.
+void main() {
+  var checks = 0;
+  void check(bool value, String label) {
+    checks++;
+    if (!value) throw StateError(label);
+  }
+
+  const canonical = '2026-10-26T11:00:00+03:00';
+  for (final value in [
+    canonical,
+    '2026-10-26 11:00:00',
+    '2026-10-26T08:00:00Z',
+    '2026-10-26T04:00:00-04:00',
+  ]) {
+    final date = SaudiTime.appointment(value);
+    check(date.hour == 11 && date.day == 26, 'appointment $value');
+    check(SaudiTime.appointmentToken(date) == canonical, 'canonical $value');
+  }
+  for (final zone in [
+    'UTC',
+    'Europe/London',
+    'America/New_York',
+    'Asia/Riyadh',
+  ]) {
+    final device = tz.TZDateTime.from(
+      DateTime.parse('2026-10-26T08:00:00Z'),
+      zone == 'UTC' ? tz.UTC : tz.getLocation(zone),
+    );
+    check(SaudiTime.forDisplay(device).hour == 11, 'display from $zone');
+  }
+  check(SaudiTime.instant('2026-10-26 08:00:00').hour == 11, 'naive UTC event');
+  check(
+    SaudiTime.instant('2026-10-26T11:00:00+03:00').hour == 11,
+    'zoned event',
+  );
+  check(
+    SaudiTime.appointment('2026-10-26T20:30:00Z').day == 26,
+    '23:30 Saudi day',
+  );
+  check(
+    SaudiTime.appointment('2026-10-26T21:30:00Z').day == 27,
+    '00:30 Saudi day',
+  );
+  check(
+    SaudiTime.appointment('2026-10-26').hour == 0,
+    'Saudi date-only midnight',
+  );
+  check(
+    SaudiTime.instant('2026-10-26').hour == 3,
+    'date-only UTC legacy event',
+  );
+  check(SaudiTime.tryAppointment('invalid') == null, 'invalid appointment');
+  check(SaudiTime.tryInstant(null) == null, 'missing event');
+  check(
+    SaudiTime.appointmentToken(DateTime(2026, 10, 26, 11)) == canonical,
+    'picker civil value',
+  );
+  final monthly = SaudiTime.appointment(
+    '2026-10-27 11:00:00',
+  ).add(const Duration(days: 30));
+  check(
+    monthly.day == 26 && monthly.month == 11 && monthly.hour == 11,
+    'monthly boundary',
+  );
+  // ignore: avoid_print
+  print('Saudi time contract: $checks checks passed');
+}
