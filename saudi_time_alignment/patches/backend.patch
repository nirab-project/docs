@@ -0,0 +1,42 @@
+<?php
+
+/** User-operated SELECT-only evidence collection. The agent does not run this. */
+require dirname(__DIR__) . '/vendor/autoload.php';
+$app = require dirname(__DIR__) . '/bootstrap/app.php';
+$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
+
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+$report = [
+    'app_timezone' => config('app.timezone'),
+    'business_timezone' => config('nirab_time.business_timezone', 'Asia/Riyadh'),
+    'warning' => 'Raw service_schedule values are Saudi business wall clocks; provenance still requires reconciliation.',
+    'database' => DB::selectOne('SELECT @@session.time_zone AS session_zone, @@global.time_zone AS global_zone, NOW() AS db_now, UTC_TIMESTAMP() AS db_utc'),
+    'bookings' => [],
+];
+foreach ([100005, 100007, 100008, 100009] as $id) {
+    $row = DB::table('bookings')->where('readable_id', $id)->first(['id', 'readable_id', 'service_schedule', 'booking_status', 'created_at']);
+    if (!$row) {
+        $report['bookings'][] = ['readable_id' => $id, 'status' => 'not_found'];
+        continue;
+    }
+    $entry = ['raw' => $row, 'reconciliation' => 'pending_original_UI_or_request_evidence'];
+    if (Schema::hasTable('booking_schedule_histories')) {
+        $entry['schedule_history'] = DB::table('booking_schedule_histories')->where('booking_id', $row->id)
+            ->orderBy('created_at')->limit(100)->get(['schedule', 'created_at']);
+    }
+    if (Schema::hasTable('audit_logs')) {
+        $entry['audit'] = DB::table('audit_logs')->where('entity_id', $row->id)->orderBy('created_at')->limit(100)
+            ->get(['event', 'created_at', 'old_values', 'new_values'])->map(function ($audit) {
+                foreach (['old_values', 'new_values'] as $key) {
+                    $values = json_decode($audit->$key ?? '{}', true) ?: [];
+                    // Retain only time provenance, without personal/payment data.
+                    $audit->$key = array_intersect_key($values, array_flip(['service_schedule', 'scheduled_at', 'starts_at', 'timezone', 'source', 'reason']));
+                }
+                return $audit;
+            });
+    }
+    $report['bookings'][] = $entry;
+}
+echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL;
