diff --git a/tests/Unit/SaudiTimeContractTest.php b/tests/Unit/SaudiTimeContractTest.php
new file mode 100644
index 0000000..32905df
--- /dev/null
+++ b/tests/Unit/SaudiTimeContractTest.php
@@ -0,0 +1,113 @@
+<?php
+
+namespace Tests\Unit;
+
+use App\Casts\SaudiAppointment;
+use App\Services\BranchPeriod;
+use App\Support\SaudiTime;
+use App\Traits\HasSaudiAppointment;
+use Illuminate\Config\Repository;
+use Illuminate\Container\Container;
+use Illuminate\Database\Eloquent\Model;
+use PHPUnit\Framework\TestCase;
+
+/** Pure date/cast/query-contract checks; no Laravel boot or database connection. */
+class SaudiTimeContractTest extends TestCase
+{
+    private string $originalTimezone;
+
+    protected function setUp(): void
+    {
+        $this->originalTimezone = date_default_timezone_get();
+        $container = new Container();
+        $container->instance('config', new Repository(['app' => ['timezone' => 'UTC'], 'nirab_time' => ['business_timezone' => 'Asia/Riyadh']]));
+        Container::setInstance($container);
+    }
+
+    protected function tearDown(): void
+    {
+        date_default_timezone_set($this->originalTimezone);
+        Container::setInstance(null);
+    }
+
+    public function testAppointmentsIgnoreServerTimezoneAndPreserveLegacyHour(): void
+    {
+        foreach (['UTC', 'Europe/London', 'America/New_York', 'Asia/Riyadh'] as $zone) {
+            date_default_timezone_set($zone);
+            foreach (['2026-10-26 11:00:00', '2026-10-26T11:00:00+03:00', '2026-10-26T08:00:00Z', '2026-10-26T04:00:00-04:00'] as $value) {
+                self::assertSame('2026-10-26 11:00:00', SaudiTime::forAppointmentStorage($value));
+                self::assertSame('2026-10-26T11:00:00+03:00', SaudiTime::appointmentForApi($value));
+            }
+        }
+    }
+
+    public function testCastKeepsSqlAndLegacyApiWhileExposingCanonicalAppointment(): void
+    {
+        date_default_timezone_set('UTC');
+        $model = new SaudiTimeTestModel();
+        $model->setRawAttributes(['service_schedule' => '2026-10-26 11:00:00', 'created_at' => '2026-10-26 08:00:00'], true);
+        self::assertSame('Asia/Riyadh', $model->service_schedule->timezoneName);
+        self::assertSame('2026-10-26 11:00:00', $model->toArray()['service_schedule']);
+        self::assertSame('2026-10-26T11:00:00+03:00', $model->toArray()['service_schedule_at']);
+        self::assertSame('Asia/Riyadh', $model->toArray()['timezone']);
+        self::assertSame('2026-10-26T08:00:00.000000Z', $model->toArray()['created_at']);
+        $model->service_schedule = '2026-10-26T08:00:00Z';
+        self::assertFalse($model->isDirty('service_schedule'));
+        $model->service_schedule = '2026-10-26T09:00:00Z';
+        self::assertSame('2026-10-26 12:00:00', $model->getAttributes()['service_schedule']);
+    }
+
+    public function testExistingReminderKeysDoNotChangeWhenTheScheduleCastChanges(): void
+    {
+        $legacyKey = \Carbon\Carbon::parse('2026-10-26 11:00:00', 'UTC')->format('U');
+        self::assertSame($legacyKey, SaudiTime::appointmentIdentity('2026-10-26 11:00:00'));
+        self::assertSame($legacyKey, SaudiTime::appointmentIdentity('2026-10-26T08:00:00Z'));
+    }
+
+    public function testDayBoundaryAndTechnicalInstantRemainDistinct(): void
+    {
+        self::assertSame('2026-10-26T23:30:00+03:00', SaudiTime::appointmentForApi('2026-10-26T20:30:00Z'));
+        self::assertSame('2026-10-27T00:30:00+03:00', SaudiTime::appointmentForApi('2026-10-26T21:30:00Z'));
+        self::assertSame('2026-10-26T08:00:00+00:00', SaudiTime::formatUtcInstantForApi('2026-10-26 08:00:00'));
+        self::assertSame('2026-10-26 11:00:00', SaudiTime::formatInstantSaudi('2026-10-26T08:00:00Z', 'Y-m-d H:i:s'));
+    }
+
+    public function testSaudiReportDaysUseWallBoundariesForAppointmentsAndUtcForEvents(): void
+    {
+        $filters = BranchPeriod::dates('custom', '2026-10-26', '2026-10-26');
+        self::assertSame('2026-10-25 21:00:00', $filters['start']);
+        self::assertSame('2026-10-26 21:00:00', $filters['end']);
+        $query = new class {
+            public array $calls = [];
+            public function where(...$args): self { $this->calls[] = $args; return $this; }
+        };
+        BranchPeriod::apply($query, 'bookings.service_schedule', $filters);
+        self::assertSame([['bookings.service_schedule', '>=', '2026-10-26 00:00:00'], ['bookings.service_schedule', '<', '2026-10-27 00:00:00']], $query->calls);
+        $query->calls = [];
+        // Analytics requests expose from/to as UTC datetimes; boundaries still come from start/end.
+        BranchPeriod::apply($query, 'bookings.service_schedule', array_merge($filters, ['from' => $filters['start'], 'to' => $filters['end']]));
+        self::assertSame('2026-10-26 00:00:00', $query->calls[0][2]);
+        self::assertSame('2026-10-27 00:00:00', $query->calls[1][2]);
+        $query->calls = [];
+        BranchPeriod::apply($query, 'created_at', $filters);
+        self::assertSame([['created_at', '>=', '2026-10-25 21:00:00'], ['created_at', '<', '2026-10-26 21:00:00']], $query->calls);
+    }
+
+    public function testWeeklyAndMonthlyIntervalsUseExactSaudiInstants(): void
+    {
+        $weekly = SaudiTime::parseCustomerAppointment('2026-10-26 11:00:00');
+        self::assertTrue($weekly->copy()->addDays(7)->gt(SaudiTime::parseCustomerAppointment('2026-10-28 11:00:00')));
+        self::assertTrue($weekly->copy()->addDays(7)->lte(SaudiTime::parseCustomerAppointment('2026-11-03 11:00:00')));
+        $monthly = SaudiTime::parseCustomerAppointment('2026-10-27T11:00:00+03:00');
+        self::assertSame('2026-11-26T11:00:00+03:00', $monthly->copy()->addDays(30)->toIso8601String());
+        self::assertSame(30 * 24 * 3600, $monthly->copy()->addDays(30)->timestamp - $monthly->timestamp);
+    }
+}
+
+class SaudiTimeTestModel extends Model
+{
+    use HasSaudiAppointment;
+    protected $dateFormat = 'Y-m-d H:i:s';
+    protected $casts = ['service_schedule' => SaudiAppointment::class];
+    protected $appends = ['service_schedule_at', 'timezone'];
+}
diff --git a/tools/saudi-time-baseline.php b/tools/saudi-time-baseline.php
