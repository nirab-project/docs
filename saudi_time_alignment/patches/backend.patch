+<?php
+
+namespace App\Casts;
+
+use App\Support\SaudiTime;
+use Illuminate\Contracts\Database\Eloquent\CastsAttributes;
+use Illuminate\Contracts\Database\Eloquent\SerializesCastableAttributes;
+use Illuminate\Database\Eloquent\Model;
+
+/** No historical row mutation. Preserve the legacy wall-clock API field. */
+final class SaudiAppointment implements CastsAttributes, SerializesCastableAttributes
+{
+    public bool $withoutObjectCaching = true;
+
+    public function get(Model $model, string $key, mixed $value, array $attributes): mixed
+    {
+        return $value === null ? null : SaudiTime::parseCustomerAppointment($value);
+    }
+
+    public function set(Model $model, string $key, mixed $value, array $attributes): mixed
+    {
+        return $value === null ? null : SaudiTime::forAppointmentStorage($value);
+    }
+
+    public function serialize(Model $model, string $key, mixed $value, array $attributes): mixed
+    {
+        return $value === null ? null : SaudiTime::forAppointmentStorage($value);
+    }
+}
diff --git a/app/Support/SaudiTime.php b/app/Support/SaudiTime.php
new file mode 100644
index 0000000..d19d49d
--- /dev/null
+++ b/app/Support/SaudiTime.php
@@ -0,0 +1,61 @@
+<?php
+
+namespace App\Support;
+
+use DateTimeInterface;
+use Illuminate\Support\Carbon;
+
+/** App/ORM/job timestamps stay UTC. Only business wall clocks use this zone. */
+final class SaudiTime
+{
+    public static function timezone(): string
+    {
+        return config('nirab_time.business_timezone', 'Asia/Riyadh');
+    }
+
+    public static function now(): Carbon
+    {
+        return Carbon::now(self::timezone());
+    }
+
+    /** Unzoned inputs are Saudi civil time; zoned inputs identify an instant. */
+    public static function parseCustomerAppointment(string|DateTimeInterface $value): Carbon
+    {
+        return ($value instanceof DateTimeInterface ? Carbon::instance($value) : Carbon::parse($value, self::timezone()))
+            ->setTimezone(self::timezone());
+    }
+
+    public static function forAppointmentStorage(string|DateTimeInterface $value): string
+    {
+        return self::parseCustomerAppointment($value)->format('Y-m-d H:i:s');
+    }
+
+    public static function appointmentForApi(string|DateTimeInterface $value): string
+    {
+        return self::parseCustomerAppointment($value)->toIso8601String();
+    }
+
+    public static function formatAppointmentSaudi(string|DateTimeInterface $value, string $format = 'd-M-Y h:i A'): string
+    {
+        return self::parseCustomerAppointment($value)->format($format);
+    }
+
+    /** Preserve pre-existing reminder/event keys derived from the legacy SQL clock.
+     * This identity token is deliberately not the appointment's actual UTC instant.
+     */
+    public static function appointmentIdentity(string|DateTimeInterface $value): string
+    {
+        return Carbon::parse(self::forAppointmentStorage($value), 'UTC')->format('U');
+    }
+
+    public static function formatUtcInstantForApi(string|DateTimeInterface $value): string
+    {
+        return ($value instanceof DateTimeInterface ? Carbon::instance($value) : Carbon::parse($value, 'UTC'))
+            ->utc()->toIso8601String();
+    }
+
+    public static function formatInstantSaudi(string|DateTimeInterface $value, string $format = 'd-M-Y h:i A'): string
+    {
+        return Carbon::parse(self::formatUtcInstantForApi($value))->setTimezone(self::timezone())->format($format);
+    }
+}
