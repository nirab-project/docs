+$files = new \Illuminate\Filesystem\Filesystem();
+$cache = sys_get_temp_dir() . '/nirab-branch-blade-' . getmypid();
+$files->makeDirectory($cache, 0755, true);
+$compiler = new \Illuminate\View\Compilers\BladeCompiler($files, $cache);
+$root = dirname(__DIR__);
+$paths = array_merge(glob($root . '/resources/views/branch/*.blade.php'), [
+    $root . '/Modules/ServiceManagement/Resources/views/admin/operations.blade.php',
+    $root . '/Modules/AdminModule/Resources/views/quality/index.blade.php',
