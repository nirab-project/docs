diff --git a/app/Http/Controllers/BranchFinanceController.php b/app/Http/Controllers/BranchFinanceController.php
new file mode 100644
index 0000000..8b61364
--- /dev/null
+++ b/app/Http/Controllers/BranchFinanceController.php
@@ -0,0 +1,61 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Services\{AuditService, NirabFinanceAccess};
+use Illuminate\Http\Request;
+use Illuminate\Routing\Controller;
+use Illuminate\Support\Facades\{DB, Storage};
+use Modules\BookingModule\Entities\{Booking, BookingRepeat};
+use Modules\OdooIntegration\Models\{Invoice, Outbox};
+use Modules\OdooIntegration\Services\OutboxService;
+use Modules\PaymentModule\Entities\PaymentRefund;
+use Modules\PaymentModule\Services\RefundService;
+
+class BranchFinanceController extends Controller
+{
+    public function __construct(private readonly NirabFinanceAccess $access) {}
+
+    public function pdf(Request $request, string $id)
+    {
+        $this->access->authorize($request->user(), 'view_cash', $request->branch_id);
+        $invoice = Invoice::where('branch_id', $request->branch_id)->findOrFail($id);
+        abort_unless($invoice->status === 'posted' && $invoice->pdf_path && Storage::disk('local')->exists($invoice->pdf_path), 404);
+        app(AuditService::class)->record('invoice.pdf_downloaded', $invoice, [], [], $request->user(), $invoice->branch_id);
+        return Storage::disk('local')->download($invoice->pdf_path, 'NIRAB-' . $invoice->id . '.pdf', ['Content-Type' => 'application/pdf', 'Cache-Control' => 'private, no-store', 'X-Content-Type-Options' => 'nosniff']);
+    }
+
+    public function retry(Request $request, string $id, OutboxService $service)
+    {
+        $this->access->authorize($request->user(), 'accounting_retry', $request->branch_id);
+        $data = $request->validate(['reason' => 'required|string|max:2000']);
+        $row = Outbox::where('branch_id', $request->branch_id)->findOrFail($id);
+        DB::transaction(function () use ($row, $service, $request, $data): void {
+            $service->retry($row->id);
+            app(AuditService::class)->record('odoo.retry_requested', $row, ['status' => $row->status], $data + ['status' => 'pending'], $request->user(), $row->branch_id);
+        });
+        return back()->with('success', __('branch.saved'));
+    }
+
+    public function refund(Request $request, RefundService $service)
+    {
+        $this->access->authorize($request->user(), 'refund', $request->branch_id);
+        $data = $request->validate(['kind' => 'required|in:booking,booking_repeat', 'booking_id' => 'required|uuid', 'payment_request_id' => 'nullable|uuid', 'amount' => 'required|numeric|gt:0|decimal:0,2', 'destination' => 'required|in:wallet,original', 'reason' => 'required|string|max:2000', 'idempotency_key' => 'required|uuid']);
+        $subject = ($data['kind'] === 'booking_repeat' ? BookingRepeat::withoutGlobalScopes() : Booking::withoutGlobalScopes())->where('provider_id', $request->branch_id)->findOrFail($data['booking_id']);
+        $service->request($subject, (float) $data['amount'], $data['destination'], $data['reason'], 'branch-refund:' . $request->branch_id . ':' . $data['idempotency_key'], $request->user(), $data['payment_request_id'] ?? null);
+        return back()->with('success', __('branch.saved'));
+    }
+
+    public function retryRefund(Request $request, string $id)
+    {
+        $this->access->authorize($request->user(), 'refund', $request->branch_id);
+        $data = $request->validate(['reason' => 'required|string|max:2000']);
+        DB::transaction(function () use ($request, $id, $data): void {
+            $refund = PaymentRefund::where('provider_id', $request->branch_id)->whereNotNull('booking_id')->whereKey($id)->lockForUpdate()->firstOrFail();
+            abort_unless($refund->status === 'requires_attention' && $refund->destination === 'original', 409);
+            $refund->forceFill(['status' => 'pending', 'attempts' => 0, 'last_error' => null, 'available_at' => now(), 'locked_until' => null, 'lease_token' => null])->save();
+            app(AuditService::class)->record('payment.refund_retry', $refund, ['status' => 'requires_attention'], $data + ['status' => 'pending'], $request->user(), $request->branch_id);
+        });
+        return back()->with('success', __('branch.saved'));
+    }
+}
