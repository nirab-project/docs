+    $root . '/Modules/ProviderManagement/Resources/views/layouts/partials/_aside.blade.php',
+]);
+$failed = 0;
+foreach ($paths as $index => $path) {
+    $compiled = $compiler->compileString(file_get_contents($path));
+    $temporary = $cache . '/' . $index . '.php';
+    file_put_contents($temporary, $compiled);
+    exec('"' . PHP_BINARY . '" -l ' . escapeshellarg($temporary) . ' 2>&1', $output, $code);
+    if ($code) { echo $path . "\n" . implode("\n", $output) . "\n"; $failed++; }
