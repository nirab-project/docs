@@ -0,0 +1,22 @@
+(() => {
+    'use strict';
+    const config = window.nirabOperations;
+    if (!config?.branchId || !document.getElementById('dispatch-alerts')) return;
+    const {api, run, pages, byId, notice} = window.nirabOperationsUi;
+    const labels = config.branchLabels;
+    const load = async (page = 1) => {
+        const result = await api('/alerts?page=' + page);
+        const target = byId('dispatch-alerts'); target.replaceChildren();
+        for (const alert of result.data) {
+            const row = document.createElement('div'); row.className = 'border rounded p-3 mb-2';
+            const title = document.createElement('p'); title.textContent = [alert.type, alert.booking_id, alert.created_at].filter(Boolean).join(' · ');
+            const reason = document.createElement('input'); reason.className = 'form-control mb-2'; reason.maxLength = 2000; reason.placeholder = labels.reason; reason.setAttribute('aria-label', labels.reason);
+            const resolve = document.createElement('button'); resolve.className = 'btn btn-outline-primary'; resolve.textContent = labels.resolve;
+            resolve.onclick = () => run(async () => { if (!reason.value.trim()) { notice(labels.reason); return; } resolve.disabled = true; try { await api('/alerts/' + alert.id + '/resolve', {reason: reason.value}, 'PUT'); await load(page); } finally { resolve.disabled = false; } });
