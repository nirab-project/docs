diff --git a/app/Http/Middleware/BranchWorkspaceContext.php b/app/Http/Middleware/BranchWorkspaceContext.php
new file mode 100644
index 0000000..d6a1956
--- /dev/null
+++ b/app/Http/Middleware/BranchWorkspaceContext.php
@@ -0,0 +1,31 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Services\OperationalAccess;
+use Closure;
+use Illuminate\Http\Request;
+use Modules\ProviderManagement\Entities\Provider;
+
+class BranchWorkspaceContext
+{
+    public function handle(Request $request, Closure $next)
+    {
+        abort_unless(nirab_branch_mode(), 404);
+        $actor = $request->user();
+        abort_unless($actor && $actor->is_active && in_array($actor->user_type, ['super-admin', 'admin-employee', 'provider-admin', 'provider-employee'], true), 403);
+        $request->validate(['branch_id' => 'nullable|uuid', 'provider_id' => 'nullable|uuid']);
+        $branch = $request->input('branch_id', $request->input('provider_id'));
+        if (str_starts_with($actor->user_type, 'provider-')) {
+            $own = app(OperationalAccess::class)->branch($actor);
+            abort_unless($own && (!$branch || $branch === $own), 403);
+            $branch = $own;
+        }
+        abort_unless($branch, 422, __('branch.select_branch'));
+        abort_if($request->filled('provider_id') && $request->input('provider_id') !== $branch, 403);
+        $request->merge(['branch_id' => $branch, 'provider_id' => $branch]);
+        $request->attributes->set('branch_workspace', true);
+        $request->attributes->set('workspace_branch', Provider::withoutGlobalScopes()->whereNull('deleted_at')->findOrFail($branch));
+        return $next($request);
+    }
+}
