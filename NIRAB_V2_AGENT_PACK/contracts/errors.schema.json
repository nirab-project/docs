{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commerce V2 error envelope",
  "type": "object",
  "required": [
    "error",
    "meta"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "fields",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "message": {
          "type": "string"
        },
        "fields": {
          "type": "object"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": [
        "request_id",
        "contract_version"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "contract_version": {
          "const": 2
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-known-source-codes": [
    "ALLOCATION_INVALID",
    "ATTACHMENT_REJECTED",
    "AUTHENTICATION_REQUIRED",
    "BANK_REFERENCE_ALREADY_CREDITED",
